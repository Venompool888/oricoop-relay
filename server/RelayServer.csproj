<Project Sdk="Microsoft.NET.Sdk">
  <!-- Linux/Docker build of the relay server (the same RelayServer.cs that build-relay.ps1 compiles for Windows). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RelayServer</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RelayServer.cs" />
    <Compile Include="RelayPlayerLog.cs" />
  </ItemGroup>
</Project>
