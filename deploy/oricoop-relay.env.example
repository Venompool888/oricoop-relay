# Copy to /etc/oricoop-relay.env (systemd) or pass with `docker run --env-file`.
# The real file holds secrets: owner root, chmod 600, never commit it.
# All lines are optional. See docs/PLAYER-LOG.md.

# Steam Web API key for player-name lookups (https://steamcommunity.com/dev/apikey).
# Without it, names come from the public profile XML, or are skipped.
#STEAM_WEB_API_KEY=

# Player lines only in the day files, not in stdout / journald.
#ORICOOP_PLAYER_LOG_STDOUT=0

# Days to keep players-YYYY-MM-DD.log files (default 30).
#ORICOOP_PLAYER_LOG_DAYS=30

# 0 = no Steam name lookups at all (no outgoing HTTP).
#ORICOOP_PLAYER_NAME_LOOKUP=1
